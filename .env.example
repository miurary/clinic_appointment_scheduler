# Copy to .env and adjust. .env is gitignored; this file is not.
#   cp .env.example .env

# --- Core ---
# Generate a real one for anything non-local:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.dev

# Comma separated. Must list your real domain in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# From the host, Postgres is on localhost. From inside a Compose container it
# is on the service name instead: postgres://clinic:clinic@db:5432/clinic
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic

# --- Frontend origins ---
# Expo dev server: 8081 for the web bundle, 19006 for older Expo web.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
CSRF_TRUSTED_ORIGINS=

# --- Rate limits (see DEFAULT_THROTTLE_RATES) ---
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=20/hour

LOG_LEVEL=INFO

# --- Production only (config.settings.prod) ---
# SECURE_SSL_REDIRECT=true
# DB_SSLMODE=require
